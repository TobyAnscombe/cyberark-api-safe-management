---
profile: basic

# Prevent ansible-lint from auto-running ansible-galaxy install when it finds
# requirements.yml. mock_roles below stubs external roles for lint purposes.
offline: true

mock_roles:
  - cyberark_api_authentication
  - cyberark_safe_management

skip_list:
  # ignore-errors is used intentionally on the safe-exists check (404 is expected)
  - ignore-errors
  - var-naming[no-role-prefix]
  - run-once[task]
